   "source": [
    "#Preview some values in ScreenResolution column\n",
    "print(df[\"ScreenResolution\"].unique()[:5])\n",
    "\n",
    "#Extract screen width and height\n",
    "df[\"Resolution_Width\"] = df[\"ScreenResolution\"].str.extract(r'(\\d+)x')[0].astype(float)\n",
    "df[\"Resolution_Height\"] = df[\"ScreenResolution\"].str.extract(r'x(\\d+)')[0].astype(float)\n",
    "\n",
    "#Identify if the screen is IPS\n",
    "df[\"Has_IPS\"] = df[\"ScreenResolution\"].str.contains(\"IPS\", case=False, na=False).astype(int)\n",
    "\n",
    "#Identify if the screen is Touchscreen\n",
    "df[\"Has_Touchscreen\"] = df[\"ScreenResolution\"].str.contains(\"Touchscreen\", case=False, na=False).astype(int)\n",
    "\n",
    "#Calculate Pixels Per Inch (PPI) = screen resolution density\n",
    "df[\"PPI\"] = ((df[\"Resolution_Width\"]**2 + df[\"Resolution_Height\"]**2)**0.5) / df[\"Inches\"]\n",
    "\n",
    "#Display some results\n",
    "df[[\"ScreenResolution\", \"Resolution_Width\", \"Resolution_Height\", \"Has_IPS\", \"Has_Touchscreen\", \"PPI\"]].head()"
   ]
  },
